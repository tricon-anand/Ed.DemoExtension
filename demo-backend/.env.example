# Copy this file to ".env" (same folder) and remove the "#" in front of the lines you want.
# Never commit .env or share it: it holds your secrets.
# A variable set in the terminal ($env:NAME = "...") overrides the same variable here.

# --- AI assistant: ONE of these two keys (with neither, the assistant is switched off) ---
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_PROVIDER=groq              # groq or anthropic; empty = whichever key is set
# AGENT_MODEL=openai/gpt-oss-120b  # empty = claude-sonnet-5-5 (anthropic) or llama-3.3-70b-versatile (groq)
# AGENT_MAX_STEPS=10

# --- Security ---
# SECRET_KEY=paste-a-long-random-string-here-at-least-32-characters
# APP_ENV=production               # production = refuse to start without a strong SECRET_KEY
# TOKEN_MINUTES=120                # how long a login lasts
# ALLOW_OPEN_REGISTRATION=false    # true = anyone can create a new admin workspace
# LOGIN_MAX_FAILS=5
# LOGIN_WINDOW_SECONDS=900
