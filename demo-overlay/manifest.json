{
  "manifest_version": 3,
  "name": "Demo Overlay",
  "version": "0.5.0",
  "description": "Replace data on any web app with scenario-based mock data for sales demos.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "activeTab", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Demo Overlay",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "popup.html" },
  "commands": {
    "toggle-demo": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Switch between demo data and real data"
    },
    "next-profile": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Switch to the next profile (country / persona)"
    },
    "toggle-toolbar": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Show or hide the presenter toolbar"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
